+/* Skip malformed or oversized lines without treating their tails as settings. */
+static bool read_locale_line(FILE *file, char *line, size_t size) {
+    size_t length = 0;
+    bool valid = true;
+    int ch;
+
+    while ((ch = fgetc(file)) != EOF && ch != '\n') {
+        if (ch == '\0' || length == size - 1) {
+            valid = false;
+        } else if (valid) {
+            line[length++] = ch;
+        }
+    }
+
+    line[valid ? length : 0] = '\0';
+    return ch != EOF || (length > 0 && !ferror(file));
+}
+
+static bool valid_locale_value(const char *value, bool language_list) {
+    if (!g_ascii_isalpha(*value)) {
+        return false;
+    }
+
+    for (const char *p = value; *p != '\0'; p++) {
+        if (language_list && *p == ':' && g_ascii_isalpha(p[1])) {
+            continue;
+        }
+        if (!g_ascii_isalnum(*p) && *p != '_' && *p != '.' && *p != '@' && *p != '-') {
+            return false;
+        }
+    }
+
+    return true;
+}
